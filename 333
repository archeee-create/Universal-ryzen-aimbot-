-- ===== СОХРАНЕНИЕ =====
local saveFolder = "RyzenAimbot"
local saveFile = "settings.json"
local fullPath = saveFolder .. "/" .. saveFile

local function ensureFolder()
    if not isfolder then return false end
    if not isfolder(saveFolder) then
        pcall(function() makefolder(saveFolder) end)
    end
    return isfolder(saveFolder)
end

local function loadSettings()
    local default = {
        fov = 20,
        maxDistance = 50,
        aimPart = "Head",
        visibleCheck = true,
        ignoreTeam = false,
        resistance = 0.85,
        espEnabled = false,
        showDistance = false,
        showName = false,
        showTeam = false,
        showLookDirection = false,
        showHighlight = false
    }
    if not ensureFolder() then return default end
    if not isfile(fullPath) then return default end
    local success, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(fullPath))
    end)
    if success and type(data) == "table" then
        for k, v in pairs(default) do
            if data[k] == nil then data[k] = v end
        end
        return data
    end
    return default
end

local settings = loadSettings()

local function saveSettings()
    if not ensureFolder() then return end
    pcall(function()
        writefile(fullPath, game:GetService("HttpService"):JSONEncode(settings))
    end)
end

-- ===== ОСНОВНЫЕ ПЕРЕМЕННЫЕ =====
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

local aimbotEnabled = false
local aimTarget = nil

-- ===== ФУНКЦИЯ ПОИСКА ЦЕЛИ =====
local function findTarget()
    local closest = nil
    local closestDist = math.huge
    local center = Camera.ViewportSize / 2
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            if settings.ignoreTeam and player.Team == LocalPlayer.Team then continue end
            
            local part = player.Character:FindFirstChild(settings.aimPart)
            if not part then continue end
            
            if settings.visibleCheck then
                local ray = Ray.new(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * settings.maxDistance * 3)
                local hit = workspace:FindPartOnRay(ray, LocalPlayer.Character)
                if hit and hit:IsDescendantOf(player.Character) == false then continue end
            end
            
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then continue end
            
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
            local worldDist = (Camera.CFrame.Position - part.Position).Magnitude
            
            if dist <= settings.fov and worldDist <= settings.maxDistance and dist < closestDist then
                closest = player
                closestDist = dist
            end
        end
    end
    return closest
end

-- ===== АИМБОТ =====
local function aimbot()
    if not aimbotEnabled then return end
    
    local target = findTarget()
    if not target then return end
    
    local part = target.Character:FindFirstChild(settings.aimPart)
    if not part then return end
    
    local targetPos = part.Position
    local currentPos = Camera.CFrame.Position
    local lookVector = (targetPos - currentPos).Unit
    local targetCFrame = CFrame.lookAt(currentPos, currentPos + lookVector)
    
    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, settings.resistance)
end


-- ============================================================
-- FPS BOOSTER V6 (ЧИСТЫЙ ТЕКСТ + ЧАСТОЕ ОБНОВЛЕНИЕ)
-- ============================================================
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    Name = "Ryzen FPS Booster",
    ConfigurationSaving = { Enabled = false }
})

local MainTab = Window:CreateTab({ name = "FPS Booster", icon = 0 })

local player = game.Players.LocalPlayer
local fpsCounter = nil
local fpsLabel = nil

-- ============================================================
-- FPS СЧЁТЧИК (БЕЗ ФОНА, ОБНОВЛЕНИЕ 0.2 СЕК)
-- ============================================================
local function CreateFPSCounter()
    if fpsCounter then return end
    
    fpsCounter = Instance.new("ScreenGui")
    fpsCounter.Name = "FPSCounter"
    fpsCounter.ResetOnSpawn = false
    fpsCounter.Parent = player.PlayerGui
    
    fpsLabel = Instance.new("TextLabel")
    fpsLabel.Size = UDim2.new(0, 100, 0, 30)
    fpsLabel.Position = UDim2.new(1, -110, 0, 10)
    fpsLabel.AnchorPoint = Vector2.new(1, 0)
    fpsLabel.BackgroundTransparency = 1  -- ПОЛНОСТЬЮ ПРОЗРАЧНЫЙ ФОН
    fpsLabel.Text = "0 FPS"
    fpsLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    fpsLabel.TextSize = 16
    fpsLabel.Font = Enum.Font.GothamBold
    fpsLabel.ZIndex = 999
    fpsLabel.Parent = fpsCounter
    
    -- Обновление КАЖДЫЕ 0.2 СЕКУНДЫ
    local frameCount = 0
    local lastTime = tick()
    
    game:GetService("RunService").RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local currentTime = tick()
        if currentTime - lastTime >= 0.2 then
            local fps = frameCount * 5  -- Умножаем на 5, потому что обновление 0.2 сек (1 / 0.2 = 5)
            fpsLabel.Text = fps .. " FPS"
            
            if fps >= 60 then
                fpsLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            elseif fps >= 30 then
                fpsLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
            else
                fpsLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
            end
            
            frameCount = 0
            lastTime = currentTime
        end
    end)
end

local function DestroyFPSCounter()
    if fpsCounter then
        fpsCounter:Destroy()
        fpsCounter = nil
        fpsLabel = nil
    end
end

-- ============================================================
-- ФУНКЦИИ ОПТИМИЗАЦИИ
-- ============================================================
local function ToggleParticles(enabled)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
            v.Enabled = enabled
        end
    end
end

local function ToggleShadows(enabled)
    game:GetService("Lighting").GlobalShadows = enabled
end

local function ToggleLights(enabled)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("SpotLight") or v:IsA("PointLight") or v:IsA("SurfaceLight") then
            v.Enabled = enabled
        end
    end
end

local function ToggleAnimations(enabled)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("AnimationTrack") then
            if enabled then
                pcall(function() v:Play() end)
            else
                pcall(function() v:Stop() end)
            end
        end
    end
end

local function ToggleSounds(enabled)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Sound") then
            v.Volume = enabled and 1 or 0
        end
    end
end

local function ToggleNeon(enabled)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Material == Enum.Material.Neon then
            v.Material = enabled and Enum.Material.Neon or Enum.Material.SmoothPlastic
        end
    end
end

-- ============================================================
-- ПЕРЕКЛЮЧАТЕЛИ В RAYFIELD
-- ============================================================
MainTab:CreateSection({ name = "FPS Счётчик" })

MainTab:CreateToggle({
    name = "Показывать FPS",
    current = false,
    callback = function(Value)
        if Value then
            CreateFPSCounter()
        else
            DestroyFPSCounter()
        end
    end
})

MainTab:CreateSection({ name = "Оптимизация" })

MainTab:CreateToggle({
    name = "Отключить частицы",
    current = false,
    callback = function(Value)
        ToggleParticles(not Value)
    end
})

MainTab:CreateToggle({
    name = "Отключить тени",
    current = false,
    callback = function(Value)
        ToggleShadows(not Value)
    end
})

MainTab:CreateToggle({
    name = "Отключить свет",
    current = false,
    callback = function(Value)
        ToggleLights(not Value)
    end
})

MainTab:CreateToggle({
    name = "Отключить анимации",
    current = false,
    callback = function(Value)
        ToggleAnimations(not Value)
    end
})

MainTab:CreateToggle({
    name = "Отключить звуки",
    current = false,
    callback = function(Value)
        ToggleSounds(not Value)
    end
})

MainTab:CreateToggle({
    name = "Отключить неон",
    current = false,
    callback = function(Value)
        ToggleNeon(not Value)
    end
})


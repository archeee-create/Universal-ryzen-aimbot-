-- АВТОКЛИКЕР ДЛЯ DELTA (Mobile/Android) - ПОЛНАЯ ВЕРСИЯ
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local screenGui = Instance.new("ScreenGui")
screenGui.Parent = LocalPlayer.PlayerGui

-- ГЛАВНОЕ МЕНЮ
local menu = Instance.new("Frame")
menu.Size = UDim2.new(0, 300, 0, 420)
menu.Position = UDim2.new(0.5, -150, 0.5, -210)
menu.BackgroundColor3 = Color3.fromRGB(10, 12, 18)
menu.BackgroundTransparency = 0.05
menu.BorderSizePixel = 0
menu.ClipsDescendants = true
menu.Parent = screenGui

local menuCorner = Instance.new("UICorner")
menuCorner.CornerRadius = UDim.new(0, 20)
menuCorner.Parent = menu

local menuStroke = Instance.new("UIStroke")
menuStroke.Thickness = 1
menuStroke.Color = Color3.fromRGB(60, 160, 255)
menuStroke.Transparency = 0.3
menuStroke.Parent = menu

-- ЗАГОЛОВОК
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -60, 0, 30)
title.Position = UDim2.new(0, 10, 0, 8)
title.BackgroundTransparency = 1
title.Text = "CLICKER 2.0"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 16
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = menu

-- КНОПКА ЗАКРЫТИЯ
local closeBtn = Instance.new("ImageButton")
closeBtn.Size = UDim2.new(0, 24, 0, 24)
closeBtn.Position = UDim2.new(1, -32, 0, 8)
closeBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
closeBtn.BackgroundTransparency = 0.2
closeBtn.Image = "rbxassetid://6023426915"
closeBtn.Parent = menu

local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(1, 0)
closeCorner.Parent = closeBtn

-- КОНТЕЙНЕР ДЛЯ НАСТРОЕК
local settingsScroll = Instance.new("ScrollingFrame")
settingsScroll.Size = UDim2.new(1, -16, 0, 240)
settingsScroll.Position = UDim2.new(0, 8, 0, 46)
settingsScroll.BackgroundColor3 = Color3.fromRGB(20, 22, 32)
settingsScroll.BackgroundTransparency = 0.5
settingsScroll.BorderSizePixel = 0
settingsScroll.ClipsDescendants = true
settingsScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
settingsScroll.ScrollBarThickness = 0
settingsScroll.Parent = menu

local scrollCorner = Instance.new("UICorner")
scrollCorner.CornerRadius = UDim.new(0, 14)
scrollCorner.Parent = settingsScroll

local circles = {}
local settingsUI = {}

local screenSize = workspace.CurrentCamera.ViewportSize
local radius = 28

local function createCircle(index)
    local x = screenSize.X * (0.1 + (index - 1) * 0.27)
    local y = screenSize.Y * (0.2 + (index % 2) * 0.35)
    
    local data = {
        x = x,
        y = y,
        radius = radius,
        interval = 100,
        clicks = 10,
        time = 5,
        running = false,
        thread = nil
    }
    
    -- КРУГ НА ЭКРАНЕ
    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, radius*2, 0, radius*2)
    circle.Position = UDim2.new(0, x - radius, 0, y - radius)
    circle.BackgroundColor3 = Color3.fromRGB(70, 170, 255)
    circle.BackgroundTransparency = 0.15
    circle.BorderSizePixel = 0
    circle.Parent = screenGui
    
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle
    
    local circleStroke = Instance.new("UIStroke")
    circleStroke.Thickness = 2
    circleStroke.Color = Color3.fromRGB(130, 200, 255)
    circleStroke.Transparency = 0.3
    circleStroke.Parent = circle
    
    local num = Instance.new("TextLabel")
    num.Size = UDim2.new(1, 0, 1, 0)
    num.BackgroundTransparency = 1
    num.Text = tostring(index)
    num.TextColor3 = Color3.fromRGB(255, 255, 255)
    num.TextSize = 16
    num.Font = Enum.Font.GothamBold
    num.TextScaled = true
    num.Parent = circle
    
    data.object = circle
    
    -- ПЕРЕТАСКИВАНИЕ КРУГА
    local drag = false
    local dx, dy = 0, 0
    
    circle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            local pos = UserInputService:GetMouseLocation()
            dx = pos.X - data.x
            dy = pos.Y - data.y
        end
    end)
    
    circle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if not drag then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local nx = math.clamp(input.Position.X - dx, 0, screenSize.X - radius*2)
            local ny = math.clamp(input.Position.Y - dy, 0, screenSize.Y - radius*2)
            data.x = nx + radius
            data.y = ny + radius
            circle.Position = UDim2.new(0, nx, 0, ny)
        end
    end)
    
    -- НАСТРОЙКИ В МЕНЮ
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 85)
    frame.Position = UDim2.new(0, 5, 0, (index - 1) * 91 + 5)
    frame.BackgroundColor3 = Color3.fromRGB(28, 30, 42)
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = settingsScroll
    
    local fCorner = Instance.new("UICorner")
    fCorner.CornerRadius = UDim.new(0, 12)
    fCorner.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 60, 0, 16)
    label.Position = UDim2.new(0, 6, 0, 4)
    label.BackgroundTransparency = 1
    label.Text = "CIRCLE " .. index
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 11
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    -- РУЧНОЙ КЛИК
    local manual = Instance.new("TextButton")
    manual.Size = UDim2.new(0, 28, 0, 28)
    manual.Position = UDim2.new(1, -72, 0, 2)
    manual.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
    manual.BackgroundTransparency = 0.1
    manual.Text = "●"
    manual.TextColor3 = Color3.fromRGB(255, 200, 50)
    manual.TextSize = 18
    manual.Font = Enum.Font.GothamBold
    manual.Parent = frame
    
    local manualCorner = Instance.new("UICorner")
    manualCorner.CornerRadius = UDim.new(1, 0)
    manualCorner.Parent = manual
    
    manual.MouseButton1Click:Connect(function()
        local pos = circle.AbsolutePosition
        local cx = pos.X + radius
        local cy = pos.Y + radius
        local mouse = LocalPlayer:GetMouse()
        local ox, oy = mouse.X, mouse.Y
        mouse.X = cx
        mouse.Y = cy
        mouse:Button1Down()
        task.wait(0.02)
        mouse:Button1Up()
        mouse.X = ox
        mouse.Y = oy
    end)
    
    -- АВТОЗАПУСК
    local run = Instance.new("TextButton")
    run.Size = UDim2.new(0, 32, 0, 22)
    run.Position = UDim2.new(1, -38, 0, 2)
    run.BackgroundColor3 = Color3.fromRGB(60, 200, 120)
    run.Text = "▶"
    run.TextColor3 = Color3.fromRGB(255, 255, 255)
    run.TextSize = 12
    run.Font = Enum.Font.GothamBold
    run.Parent = frame
    
    local runCorner = Instance.new("UICorner")
    runCorner.CornerRadius = UDim.new(0, 8)
    runCorner.Parent = run
    
    run.MouseButton1Click:Connect(function()
        data.running = not data.running
        
        if data.running then
            run.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
            run.Text = "■"
            
            local int = data.interval
            local clk = data.clicks
            local t = data.time
            
            data.thread = RunService.Heartbeat:Connect(function()
                local pos = circle.AbsolutePosition
                local cx = pos.X + radius
                local cy = pos.Y + radius
                local maxC = math.floor(t * (1000 / int) * clk)
                
                for i = 1, maxC do
                    task.wait(int / 1000)
                    local mouse = LocalPlayer:GetMouse()
                    local ox, oy = mouse.X, mouse.Y
                    mouse.X = cx
                    mouse.Y = cy
                    mouse:Button1Down()
                    task.wait(0.01)
                    mouse:Button1Up()
                    mouse.X = ox
                    mouse.Y = oy
                end
            end)
        else
            run.BackgroundColor3 = Color3.fromRGB(60, 200, 120)
            run.Text = "▶"
            if data.thread then
                data.thread:Disconnect()
                data.thread = nil
            end
        end
    end)
    
    -- СЛАЙДЕРЫ
    local function makeSlider(text, y, min, max, def, callback)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, 20, 0, 14)
        lbl.Position = UDim2.new(0, 4, 0, y)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(160, 170, 190)
        lbl.TextSize = 10
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextXAlignment = Enum.TextXAlignment.Right
        lbl.Parent = frame
        
        local sFrame = Instance.new("Frame")
        sFrame.Size = UDim2.new(0, 90, 0, 12)
        sFrame.Position = UDim2.new(0, 34, 0, y + 1)
        sFrame.BackgroundColor3 = Color3.fromRGB(45, 50, 60)
        sFrame.BorderSizePixel = 0
        sFrame.Parent = frame
        
        local sCorner = Instance.new("UICorner")
        sCorner.CornerRadius = UDim.new(0, 6)
        sCorner.Parent = sFrame
        
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((def - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(70, 190, 255)
        fill.BorderSizePixel = 0
        fill.Parent = sFrame
        
        local fCorner2 = Instance.new("UICorner")
        fCorner2.CornerRadius = UDim.new(0, 6)
        fCorner2.Parent = fill
        
        local val = Instance.new("TextLabel")
        val.Size = UDim2.new(0, 24, 0, 12)
        val.Position = UDim2.new(1, 3, 0, 0)
        val.BackgroundTransparency = 1
        val.Text = tostring(def)
        val.TextColor3 = Color3.fromRGB(255, 255, 255)
        val.TextSize = 10
        val.Font = Enum.Font.GothamMedium
        val.Parent = frame
        
        local drag = false
        local cur = def
        
        sFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                drag = true
                local pos = UserInputService:GetMouseLocation().X - sFrame.AbsolutePosition.X
                local p = math.clamp(pos / sFrame.AbsoluteSize.X, 0, 1)
                cur = math.floor(min + (max - min) * p)
                fill.Size = UDim2.new(p, 0, 1, 0)
                val.Text = tostring(cur)
                callback(cur)
            end
        end)
        
        sFrame.InputEnded:Connect(function()
            drag = false
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if not drag then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                local pos = input.Position.X - sFrame.AbsolutePosition.X
                local p = math.clamp(pos / sFrame.AbsoluteSize.X, 0, 1)
                cur = math.floor(min + (max - min) * p)
                fill.Size = UDim2.new(p, 0, 1, 0)
                val.Text = tostring(cur)
                callback(cur)
            end
        end)
        
        return function()
            return cur
        end
    end
    
    local getInt = makeSlider("I", 24, 50, 2000, 100, function(v)
        data.interval = v
    end)
    
    local getClk = makeSlider("C", 40, 1, 100, 10, function(v)
        data.clicks = v
    end)
    
    local getTime = makeSlider("T", 56, 1, 60, 5, function(v)
        data.time = v
    end)
    
    data.getInt = getInt
    data.getClk = getClk
    data.getTime = getTime
    data.runBtn = run
    
    settingsScroll.CanvasSize = UDim2.new(0, 0, 0, index * 91 + 10)
    
    table.insert(circles, data)
    table.insert(settingsUI, {
        frame = frame,
        runBtn = run,
        manual = manual
    })
end

for i = 1, 4 do
    createCircle(i)
end

-- ОБЩИЙ ЗАПУСК
local control = Instance.new("Frame")
control.Size = UDim2.new(1, -16, 0, 44)
control.Position = UDim2.new(0, 8, 0, 296)
control.BackgroundColor3 = Color3.fromRGB(20, 22, 32)
control.BackgroundTransparency = 0.5
control.BorderSizePixel = 0
control.Parent = menu

local controlCorner = Instance.new("UICorner")
controlCorner.CornerRadius = UDim.new(0, 12)
controlCorner.Parent = control

local allBtn = Instance.new("TextButton")
allBtn.Size = UDim2.new(0, 100, 0, 30)
allBtn.Position = UDim2.new(0.5, -50, 0.5, -15)
allBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 120)
allBtn.Text = "▶ ALL"
allBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
allBtn.TextSize = 13
allBtn.Font = Enum.Font.GothamBold
allBtn.Parent = control

local allCorner = Instance.new("UICorner")
allCorner.CornerRadius = UDim.new(0, 14)
allCorner.Parent = allBtn

local allRunning = false
local allThreads = {}

allBtn.MouseButton1Click:Connect(function()
    allRunning = not allRunning
    
    if allRunning then
        allBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        allBtn.Text = "■ ALL"
        
        for _, d in ipairs(circles) do
            if not d.running then
                d.running = true
                if d.runBtn then
                    d.runBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
                    d.runBtn.Text = "■"
                end
                
                local int = d.interval
                local clk = d.clicks
                local t = d.time
                
                local th = RunService.Heartbeat:Connect(function()
                    local pos = d.object.AbsolutePosition
                    local cx = pos.X + radius
                    local cy = pos.Y + radius
                    local maxC = math.floor(t * (1000 / int) * clk)
                    
                    for i = 1, maxC do
                        task.wait(int / 1000)
                        local mouse = LocalPlayer:GetMouse()
                        local ox, oy = mouse.X, mouse.Y
                        mouse.X = cx
                        mouse.Y = cy
                        mouse:Button1Down()
                        task.wait(0.01)
                        mouse:Button1Up()
                        mouse.X = ox
                        mouse.Y = oy
                    end
                end)
                
                d.thread = th
                table.insert(allThreads, th)
            end
        end
    else
        allBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 120)
        allBtn.Text = "▶ ALL"
        
        for _, th in ipairs(allThreads) do
            th:Disconnect()
        end
        allThreads = {}
        
        for _, d in ipairs(circles) do
            d.running = false
            if d.runBtn then
                d.runBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 120)
                d.runBtn.Text = "▶"
            end
            if d.thread then
                d.thread:Disconnect()
                d.thread = nil
            end
        end
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    for _, th in ipairs(allThreads) do
        th:Disconnect()
    end
    for _, d in ipairs(circles) do
        if d.thread then
            d.thread:Disconnect()
        end
        d.object:Destroy()
    end
    screenGui:Destroy()
end)

-- ПЕРЕТАСКИВАНИЕ МЕНЮ
local menuDrag = false
local mdX, mdY = 0, 0

menu.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        menuDrag = true
        local pos = UserInputService:GetMouseLocation()
        mdX = pos.X - menu.AbsolutePosition.X
        mdY = pos.Y - menu.AbsolutePosition.Y
    end
end)

menu.InputEnded:Connect(function()
    menuDrag = false
end)

UserInputService.InputChanged:Connect(function(input)
    if menuDrag and input.UserInputType == Enum.UserInputType.MouseMovement then
        local pos = UserInputService:GetMouseLocation()
        menu.Position = UDim2.new(0, pos.X - mdX, 0, pos.Y - mdY)
    end
end)

-- АНИМАЦИЯ ПОЯВЛЕНИЯ
for i = 2, 0, -1 do
    menu.BackgroundTransparency = i * 0.03 + 0.05
    task.wait(0.02)
end

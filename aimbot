    if not line or not tip then
        return
    end

    local startPosition = root.Position + Vector3.new(0, 1, 0)
    local direction = root.CFrame.LookVector
    local length = 3.5
    local endPosition = startPosition + direction * length

    line.Transparency = 0.15
    tip.Transparency = 0.05

    line.Size = Vector3.new(0.08, 0.08, length)
    line.CFrame = CFrame.lookAt(
        (startPosition + endPosition) / 2,
        endPosition
    )

    tip.CFrame = CFrame.new(endPosition)
end

local function UpdateVisual(object)
    local player = object.player
    local character = player.Character

    if not character then
        return
    end

    if object.character ~= character then
        object = CreateVisual(player)

        if not object then
            return
        end
    end

    local root = GetRoot(character)

    if not root or not IsAlive(character) then
        if object.billboard then
            object.billboard.Enabled = false
        end

        if object.highlight then
            object.highlight.Enabled = false
        end

        if object.outline then
            object.outline.Enabled = false
        end

        if object.box then
            object.box.Visible = false
        end

        if object.box3D then
            object.box3D.Visible = false
        end

        if object.outline3D then
            object.outline3D.Visible = false
        end

        return
    end

    if Settings.VisualsIgnoreTeam
        and LocalPlayer.Team ~= nil
        and player.Team == LocalPlayer.Team then
        if object.billboard then
            object.billboard.Enabled = false
        end

        if object.highlight then
            object.highlight.Enabled = false
        end

        if object.outline then
            object.outline.Enabled = false
        end

        if object.box then
            object.box.Visible = false
        end

        if object.box3D then
            object.box3D.Visible = false
        end

        if object.outline3D then
            object.outline3D.Visible = false
        end

        if object.lookLine then
            object.lookLine.Transparency = 1
        end

        if object.lookTip then
            object.lookTip.Transparency = 1
        end

        return
    end

    local distance = (Camera.CFrame.Position - root.Position).Magnitude

    if distance > Settings.VisualsDistance then
        if object.billboard then
            object.billboard.Enabled = false
        end

        if object.highlight then
            object.highlight.Enabled = false
        end

        if object.outline then
            object.outline.Enabled = false
        end

        if object.box then
            object.box.Visible = false
        end

        if object.box3D then
            object.box3D.Visible = false
        end

        if object.outline3D then
            object.outline3D.Visible = false
        end

        if object.lookLine then
            object.lookLine.Transparency = 1
        end

        if object.lookTip then
            object.lookTip.Transparency = 1
        end

        return
    end

    UpdateBillboard(object, distance)

    if Settings.ShowHighlight then
        local highlight = CreateHighlight(object)
        highlight.Enabled = true
    elseif object.highlight then
        object.highlight.Enabled = false
    end

    if Settings.ShowOutline then
        local outline = CreateOutline(object)
        outline.Enabled = true
    elseif object.outline then
        object.outline.Enabled = false
    end

    if Settings.ShowBox then
        CreateBox(object)
    else
        if object.box then
            object.box.Visible = false
        end
    end

    UpdateBox(object)
    Update3DBox(object)
    Update3DOutline(object)
    UpdateSkeleton(object)
    UpdateLookDirection(object)
end


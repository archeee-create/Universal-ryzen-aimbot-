local function RebuildSettings()
    if CurrentTab == "AIM" then
        BuildAimSettings()
    else
        BuildVisualsSettings()
    end

    SettingsScroll.CanvasPosition = Vector2.zero
end

local function SetSettingsOpen(open)
    SettingsOpen = open

    local targetHeight = open and GetSettingsHeight() or 0

    TweenService:Create(
        SettingsPanel,
        TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Size = UDim2.new(1, 0, 0, targetHeight)
        }
    ):Play()

    if open then
        RebuildSettings()

        task.delay(0.25, function()
            if SettingsOpen then
                RebuildSettings()
            end
        end)
    end
end

local function SetCurrentTab(tab)
    CurrentTab = tab

    if tab == "AIM" then
        TabSelector.Text = "AIM ▼"
    else
        TabSelector.Text = "VISUALS ▼"
    end

    if SettingsOpen then
        RebuildSettings()
    end
end

local function GetCharacterBounds(character)
    local parts = {}

    for _, item in ipairs(character:GetDescendants()) do
        if item:IsA("BasePart") then
            table.insert(parts, item)
        end
    end

    if #parts == 0 then
        return nil
    end

    local minX = math.huge
    local minY = math.huge
    local maxX = -math.huge
    local maxY = -math.huge
    local found = false

    for _, part in ipairs(parts) do
        local cf = part.CFrame
        local size = part.Size

        local corners = {
            cf * Vector3.new(-size.X / 2, -size.Y / 2, -size.Z / 2),
            cf * Vector3.new(-size.X / 2, -size.Y / 2, size.Z / 2),
            cf * Vector3.new(-size.X / 2, size.Y / 2, -size.Z / 2),
            cf * Vector3.new(-size.X / 2, size.Y / 2, size.Z / 2),
            cf * Vector3.new(size.X / 2, -size.Y / 2, -size.Z / 2),
            cf * Vector3.new(size.X / 2, -size.Y / 2, size.Z / 2),
            cf * Vector3.new(size.X / 2, size.Y / 2, -size.Z / 2),
            cf * Vector3.new(size.X / 2, size.Y / 2, size.Z / 2)
        }

        for _, cornerPosition in ipairs(corners) do
            local screenPosition, visible = Camera:WorldToViewportPoint(cornerPosition)

            if visible or screenPosition.Z > 0 then
                found = true
                minX = math.min(minX, screenPosition.X)
                minY = math.min(minY, screenPosition.Y)
                maxX = math.max(maxX, screenPosition.X)
                maxY = math.max(maxY, screenPosition.Y)
            end
        end
    end

    if not found then
        return nil
    end

    return minX, minY, maxX, maxY
end

local function UpdateBox(object)
    if not object.box then
        return
    end

    if not Settings.ShowBox then
        object.box.Visible = false
        return
    end

    local minX, minY, maxX, maxY = GetCharacterBounds(object.character)

    if not minX then
        object.box.Visible = false
        return
    end

    local viewport = Camera.ViewportSize

    minX = math.clamp(minX, -100, viewport.X + 100)
    maxX = math.clamp(maxX, -100, viewport.X + 100)
    minY = math.clamp(minY, -100, viewport.Y + 100)
    maxY = math.clamp(maxY, -100, viewport.Y + 100)

    object.box.Position = UDim2.fromOffset(minX, minY)
    object.box.Size = UDim2.fromOffset(
        math.max(2, maxX - minX),
        math.max(2, maxY - minY)
    )
    object.box.Visible = true
end


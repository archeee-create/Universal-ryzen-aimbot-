--==================================================
-- CHARACTER HELPERS
--==================================================

local function GetCharacter(player)
    return player and player.Character
end

local function GetHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function GetRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function GetTargetPart(character)
    if not character then
        return nil
    end

    if Settings.AimPart == "Torso" then
        return character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
    end

    return character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- TARGET VALID
--==================================================

local function BasicTargetValid(player)
    if not player or player == LocalPlayer then
        return false
    end

    if Settings.IgnoreTeam
        and player.Team == LocalPlayer.Team then

        return false
    end

    local character = player.Character
    local humanoid = GetHumanoid(character)
    local root = GetRoot(character)
    local part = GetTargetPart(character)
    local localRoot = GetRoot(LocalPlayer.Character)

    if not character
        or not humanoid
        or humanoid.Health <= 0
        or not root
        or not part
        or not localRoot then

        return false
    end

    return (
        root.Position - localRoot.Position
    ).Magnitude <= Settings.MaxDistance
end

--==================================================
-- VISIBILITY
--==================================================

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function IsVisible(part, character)
    if not Settings.VisibleCheck then
        return true
    end

    if not Camera
        or not part
        or not character then

        return false
    end

    RayParams.FilterDescendantsInstances = {
        LocalPlayer.Character,
        Camera
    }

    local origin = Camera.CFrame.Position
    local direction = part.Position - origin

    local result = workspace:Raycast(
        origin,
        direction,
        RayParams
    )

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(character)
end

--==================================================
-- CLOSEST TARGET
--==================================================

local function GetClosestTarget()
    if not Camera then
        return nil
    end

    local viewport = Camera.ViewportSize

    local center = Vector2.new(
        viewport.X / 2,
        viewport.Y / 2
    )

    local closest = nil
    local closestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do

        if BasicTargetValid(player) then

            local part = GetTargetPart(
                player.Character
            )

            if part then

                local pos, onScreen =
                    Camera:WorldToViewportPoint(
                        part.Position
                    )

                if onScreen and pos.Z > 0 then

                    local distance = (
                        Vector2.new(pos.X, pos.Y)
                        - center
                    ).Magnitude

                    if distance <= Settings.AimFOV
                        and distance < closestDistance
                        and IsVisible(
                            part,
                            player.Character
                        ) then

                        closestDistance = distance
                        closest = player
                    end
                end
            end
        end
    end

    return closest
end

--==================================================
-- 360 HORIZONTAL DIRECTION
--==================================================

-- ВАЖНО:
-- Теперь направление берётся ОТ КАМЕРЫ,
-- а не от HumanoidRootPart.
--
-- Поэтому 3-е лицо больше не переворачивает
-- перед/зад относительно маркера.

local function GetCameraHorizontalDirection(worldPosition)

    if not Camera then
        return nil
    end

    local cameraPosition = Camera.CFrame.Position

    local delta = worldPosition - cameraPosition

    local flatTarget = Vector3.new(
        delta.X,
        0,
        delta.Z
    )

    if flatTarget.Magnitude < 0.001 then
        return nil
    end

    flatTarget = flatTarget.Unit

    local forward = Vector3.new(
        Camera.CFrame.LookVector.X,
        0,
        Camera.CFrame.LookVector.Z
    )

    local right = Vector3.new(
        Camera.CFrame.RightVector.X,
        0,
        Camera.CFrame.RightVector.Z
    )

    if forward.Magnitude < 0.001
        or right.Magnitude < 0.001 then

        return nil
    end

    forward = forward.Unit
    right = right.Unit

    local x = flatTarget:Dot(right)
    local y = -flatTarget:Dot(forward)

    local direction = Vector2.new(x, y)

    if direction.Magnitude < 0.001 then
        return nil
    end

    return direction.Unit
end

--==================================================
-- HORIZONTAL SCREEN CHECK
--==================================================

local function IsHorizontallyOnScreen(worldPosition)

    if not Camera then
        return false
    end

    local cameraPosition = Camera.CFrame.Position

    local delta = worldPosition - cameraPosition

    local flat = Vector3.new(
        delta.X,
        0,
        delta.Z
    )

    if flat.Magnitude < 0.001 then
        return true
    end

    flat = flat.Unit

    local forward = Vector3.new(
        Camera.CFrame.LookVector.X,
        0,
        Camera.CFrame.LookVector.Z
    )

    local right = Vector3.new(
        Camera.CFrame.RightVector.X,
        0,
        Camera.CFrame.RightVector.Z
    )

    if forward.Magnitude < 0.001
        or right.Magnitude < 0.001 then

        return false
    end

    forward = forward.Unit
    right = right.Unit

    local forwardDot = flat:Dot(forward)
    local rightDot = math.abs(
        flat:Dot(right)
    )

    -- За камерой = не на экране.
    if forwardDot <= 0 then
        return false
    end

    -- Используем только горизонтальный угол.
    -- Наклон камеры вверх/вниз здесь вообще
    -- не участвует.

    local horizontalFOV =
        math.rad(Camera.FieldOfView)

    local halfFOV =
        horizontalFOV / 2

    local angle =
        math.atan2(
            rightDot,
            forwardDot
        )

    return angle <= halfFOV
end

--==================================================
-- ALERT
--==================================================

local function HideAlert(player)

    local obj = AlertObjects[player]

    if obj and obj.frame then
        obj.frame.Visible = false
    end
end

local function RemoveAlert(player)

    local obj = AlertObjects[player]

    if obj then

        if obj.frame then
            obj.frame:Destroy()
        end

        AlertObjects[player] = nil
    end
end

local function CreateAlert(player)

    if AlertObjects[player] then
        return AlertObjects[player]
    end

    local frame = Instance.new("Frame")
    frame.Parent = GUI
    frame.Size = UDim2.fromOffset(48, 48)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.ZIndex = 250

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(145, 80, 255)
    stroke.Thickness = 2
    stroke.Parent = frame

    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 8
    label.TextWrapped = true
    label.ZIndex = 251

    local obj = {
        frame = frame,
        label = label
    }

    AlertObjects[player] = obj

    return obj
end

local function UpdateAlert(player)

    if player == LocalPlayer
        or not Camera then

        return
    end

    local character = player.Character

    local root = character
        and GetRoot(character)

    local humanoid = character
        and GetHumanoid(character)

    local localRoot =
        GetRoot(LocalPlayer.Character)

    if not root
        or not humanoid
        or humanoid.Health <= 0
        or not localRoot then

        HideAlert(player)
        return
    end

    if Settings.IgnoreTeam
        and player.Team == LocalPlayer.Team then

        HideAlert(player)
        return
    end

    local distance = (
        root.Position - localRoot.Position
    ).Magnitude

    if distance > Settings.VisualsDistance then
        HideAlert(player)
        return
    end

    --==================================================
    -- ГЛАВНЫЙ FIX
    --==================================================

    -- Проверяем положение игрока относительно КАМЕРЫ.
    --
    -- Если он находится перед камерой и попадает
    -- в горизонтальный FOV камеры, alert скрываем.
    --
    -- Y полностью игнорируется.

    if IsHorizontallyOnScreen(root.Position) then
        HideAlert(player)
        return
    end

    --==================================================
    -- POSITION
    --==================================================

    local direction =
        GetCameraHorizontalDirection(
            root.Position
        )

    if not direction then
        HideAlert(player)
        return
    end

    local viewport = Camera.ViewportSize

    local center = Vector2.new(
        viewport.X / 2,
        viewport.Y / 2
    )

    local maxRadius =
        math.min(
            viewport.X,
            viewport.Y
        ) / 2 - 26

    local radius = math.clamp(
        Settings.AimFOV,
        24,
        math.max(24, maxRadius)
    )

    local position =
        center + direction * radius

    local obj = CreateAlert(player)

    obj.frame.Position = UDim2.fromOffset(
        position.X - 24,
        position.Y - 24
    )

    obj.label.Text = player.DisplayName

    obj.frame.Visible = true
end


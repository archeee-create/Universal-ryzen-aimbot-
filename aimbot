}

local SkeletonPairsR6 = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"}
}

local function CreateSkeleton(object)
    if object.skeletonFolder and object.skeletonFolder.Parent then
        return object.skeletonFolder
    end

    local folder = Instance.new("Folder")
    folder.Name = "ZenleSkeleton"
    folder.Parent = object.character

    local humanoid = GetHumanoid(object.character)
    local pairsList = SkeletonPairsR15

    if humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then
        pairsList = SkeletonPairsR6
    end

    local attachments = {}

    for _, pair in ipairs(pairsList) do
        local partA = object.character:FindFirstChild(pair[1])
        local partB = object.character:FindFirstChild(pair[2])

        if partA and partB and partA:IsA("BasePart") and partB:IsA("BasePart") then
            local attachmentA = Instance.new("Attachment")
            attachmentA.Name = "A"
            attachmentA.Parent = partA

            local attachmentB = Instance.new("Attachment")
            attachmentB.Name = "B"
            attachmentB.Parent = partB

            local beam = Instance.new("Beam")
            beam.Name = "Bone"
            beam.Attachment0 = attachmentA
            beam.Attachment1 = attachmentB
            beam.FaceCamera = true
            beam.Width0 = 0.035
            beam.Width1 = 0.035
            beam.Color = ColorSequence.new(Color3.fromRGB(170, 90, 255))
            beam.Transparency = NumberSequence.new(0.1)
            beam.LightEmission = 1
            beam.Parent = folder

            table.insert(attachments, attachmentA)
            table.insert(attachments, attachmentB)
        end
    end

    object.skeletonFolder = folder

    return folder
end

local function UpdateSkeleton(object)
    if not Settings.ShowSkeleton then
        if object.skeletonFolder then
            object.skeletonFolder.Parent = nil
        end
        return
    end

    local folder = CreateSkeleton(object)

    if folder then
        folder.Parent = object.character

        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Beam") then
                item.Enabled = true
            end
        end
    end
end


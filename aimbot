Connect(
    UserInputService.InputChanged,
    function(input)

        if not ActiveSlider then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or input.UserInputType ==
            Enum.UserInputType.Touch then

            ActiveSlider.update(input)
        end
    end
)

Connect(
    UserInputService.InputEnded,
    function(input)

        if not ActiveSlider then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
            Enum.UserInputType.Touch then

            local slider =
                ActiveSlider

            ActiveSlider = nil

            if slider.commit then
                slider.commit()
            end
        end
    end
)

--==================================================
-- CAMERA
--==================================================

local function RestoreCamera()

    Camera =
        workspace.CurrentCamera

    if not Camera then
        return
    end

    local character =
        LocalPlayer.Character

    local humanoid =
        character
        and GetHumanoid(character)

    if not humanoid then
        return
    end

    Camera.CameraType =
        Enum.CameraType.Custom

    Camera.CameraSubject =
        humanoid

    Camera.FieldOfView =
        Settings.CameraFOV
end

Connect(
    workspace:GetPropertyChangedSignal(
        "CurrentCamera"
    ),
    function()

        Camera =
            workspace.CurrentCamera

        task.defer(
            RestoreCamera
        )
    end
)

--==================================================
-- AIM CAMERA
--==================================================

RunService:BindToRenderStep(
    "ZenleScriptCamera",
    Enum.RenderPriority.Camera.Value + 10,
    function()

        if not AimEnabled
            or not LockedTarget
            or not Camera then

            return
        end

        local character =
            LockedTarget.Character

        local part =
            character
            and GetTargetPart(character)

        if not part
            or not BasicTargetValid(
                LockedTarget
            ) then

            LockedTarget = nil
            return
        end

        if Settings.VisibleCheck
            and not IsVisible(
                part,
                character
            ) then

            LockedTarget = nil
            return
        end

        local current =
            Camera.CFrame

        local desired =
            CFrame.lookAt(
                current.Position,
                part.Position
            )

        local strength =
            math.clamp(
                tonumber(
                    Settings.AimStrength
                ) or 85,
                1,
                100
            )

        local alpha =
            strength / 100

        Camera.CFrame =
            current:Lerp(
                desired,
                alpha
            )
    end
)

--==================================================
-- MAIN HEARTBEAT
--==================================================

Connect(
    RunService.Heartbeat,
    function()

        local now =
            os.clock()

        --==================================================
        -- FPS
        --==================================================

        FPSFrames += 1

        if now - FPSTimer >= 0.5 then

            CurrentFPS =
                math.floor(
                    FPSFrames /
                    (now - FPSTimer)
                )

            FPSFrames = 0
            FPSTimer = now
        end

        --==================================================
        -- TARGET
        --==================================================

        if AimEnabled
            and now - LastTargetUpdate >= 0.10 then

            LastTargetUpdate = now

            if LockedTarget then

                if not BasicTargetValid(
                    LockedTarget
                ) then

                    LockedTarget = nil

                else

                    local char =
                        LockedTarget.Character

                    local part =
                        char
                        and GetTargetPart(char)

                    if not part
                        or (
                            Settings.VisibleCheck
                            and not IsVisible(
                                part,
                                char
                            )
                        ) then

                        LockedTarget = nil
                    end
                end
            end

            if not LockedTarget then
                LockedTarget =
                    GetClosestTarget()
            end

        else

            if not AimEnabled then
                LockedTarget = nil
            end
        end

        --==================================================
        -- VISUALS
        --==================================================

        if VisualsEnabled
            and now - LastVisualUpdate >= 0.18 then

            LastVisualUpdate = now

            for _, player in ipairs(
                Players:GetPlayers()
            ) do

                if player ~= LocalPlayer then
                    UpdateVisual(player)
                end
            end
        end

        --==================================================
        -- 360 ALERT
        --==================================================

        -- Было: 0.14
        -- Теперь: 0.05

        if VisualsEnabled
            and Settings.Show360Alert
            and now - LastAlertUpdate >= 0.05 then

            LastAlertUpdate = now

            for _, player in ipairs(
                Players:GetPlayers()
            ) do

                if player ~= LocalPlayer then
                    UpdateAlert(player)
                end
            end
        end

        --==================================================
        -- STATUS
        --==================================================

        if now - LastStatusUpdate >= 0.5 then

            LastStatusUpdate = now

            local ping = 0

            pcall(function()

                ping =
                    math.floor(
                        LocalPlayer:GetNetworkPing()
                        * 1000
                        + 0.5
                    )
            end)

            Status.Text =
                "Ping: "
                .. ping
                .. " ms  FPS: "
                .. CurrentFPS
        end
    end
)


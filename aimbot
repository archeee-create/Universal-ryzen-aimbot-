    text.TextSize = 11
    text.TextStrokeTransparency = 0.35
    text.TextWrapped = true

    VisualObjects[player] = {
        billboard = billboard,
        text = text,
        highlight = nil
    }

    return VisualObjects[player]
end

local function GetLookArrow(root)

    local d = root.CFrame.LookVector

    if math.abs(d.X) > math.abs(d.Z) then
        return d.X > 0 and "→" or "←"
    end

    return d.Z > 0 and "↓" or "↑"
end

local function UpdateVisual(player)

    if player == LocalPlayer then
        return
    end

    local character = player.Character

    local humanoid =
        character
        and GetHumanoid(character)

    local root =
        character
        and GetRoot(character)

    local localRoot =
        GetRoot(LocalPlayer.Character)

    if not character
        or not humanoid
        or humanoid.Health <= 0
        or not root
        or not localRoot then

        RemoveVisual(player)
        return
    end

    local distance = (
        root.Position - localRoot.Position
    ).Magnitude

    if distance > Settings.VisualsDistance
        or (
            Settings.IgnoreTeam
            and player.Team == LocalPlayer.Team
        ) then

        local obj = VisualObjects[player]

        if obj then

            obj.billboard.Enabled = false

            if obj.highlight then
                obj.highlight.Enabled = false
            end
        end

        return
    end

    local obj = CreateVisual(player)

    if not obj then
        return
    end

    local parts = {}

    if Settings.ShowName then
        table.insert(
            parts,
            player.DisplayName
        )
    end

    if Settings.ShowDistance then
        table.insert(
            parts,
            tostring(
                math.floor(distance)
            ) .. "m"
        )
    end

    if Settings.ShowTeam
        and player.Team then

        table.insert(
            parts,
            player.Team.Name
        )
    end

    if Settings.ShowLookDirection then
        table.insert(
            parts,
            GetLookArrow(root)
        )
    end

    obj.text.Text =
        table.concat(parts, "  ")

    obj.billboard.Enabled =
        #parts > 0

    if Settings.ShowHighlight then

        if not obj.highlight then

            local h = Instance.new("Highlight")

            h.Name = "ZenleHighlight"
            h.Adornee = character
            h.FillTransparency = 0.75
            h.OutlineTransparency = 0.1
            h.DepthMode =
                Enum.HighlightDepthMode.AlwaysOnTop

            h.Parent = GUI

            obj.highlight = h
        end

        obj.highlight.Adornee = character
        obj.highlight.Enabled = true

    elseif obj.highlight then

        obj.highlight.Enabled = false
    end
end


Connect(
    LocalPlayer.CharacterAdded,
    function(character)

        LockedTarget = nil

        local humanoid =
            character:WaitForChild(
                "Humanoid",
                5
            )

        if humanoid then

            Connect(
                humanoid.Died,
                function()
                    LockedTarget = nil
                end
            )
        end

        task.wait(0.15)

        RestoreCamera()
        UpdateFOV()
        UpdateMainToggle()
    end
)


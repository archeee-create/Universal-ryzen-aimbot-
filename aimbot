--==================================================
-- CLEANUP
--==================================================

G.ZenleScriptCleanup = function()

    for _, connection in ipairs(
        Connections
    ) do

        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(Connections)

    ActiveSlider = nil
    LockedTarget = nil

    pcall(function()

        RunService:UnbindFromRenderStep(
            "ZenleScriptCamera"
        )
    end)

    pcall(function()

        local gui =
            PlayerGui:FindFirstChild(
                "ZenleScript"
            )

        if gui then
            gui:Destroy()
        end

        local fov =
            PlayerGui:FindFirstChild(
                "ZenleFOV"
            )

        if fov then
            fov:Destroy()
        end
    end)
end


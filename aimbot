local function ClearSettings()
    for _, child in ipairs(SettingsScroll:GetChildren()) do
        child:Destroy()
    end

    SettingsScroll.CanvasPosition = Vector2.zero
    SettingsScroll.CanvasSize = UDim2.new(0, 0, 0, 0)

    VisualToggleRefs = {}
    VisualSubToggleRefs = {}
end

local function GetSettingsHeight()
    local viewportHeight = Camera.ViewportSize.Y

    if viewportHeight <= 0 then
        return 500
    end

    return math.clamp(viewportHeight - 120, 300, 500)
end

local function UpdateCanvasSize(height)
    SettingsScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(height + 12, SettingsScroll.AbsoluteSize.Y + 1))
end


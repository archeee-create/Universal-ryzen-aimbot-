local SettingsTween

local function OpenSettings()

    if SettingsOpen then
        return
    end

    SettingsOpen = true

    RebuildSettings()

    SettingsPanel.Visible = true

    SettingsPanel.Size =
        UDim2.new(
            1,
            0,
            0,
            0
        )

    if SettingsTween then
        SettingsTween:Cancel()
    end

    SettingsTween =
        TweenService:Create(
            SettingsPanel,
            TweenInfo.new(
                0.28,
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.Out
            ),
            {
                Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        GetSettingsHeight()
                    )
            }
        )

    SettingsTween:Play()
end

local function CloseSettings()

    if not SettingsOpen then
        return
    end

    SettingsOpen = false
    AimPartDropdownOpen = false

    if SettingsTween then
        SettingsTween:Cancel()
    end

    SettingsTween =
        TweenService:Create(
            SettingsPanel,
            TweenInfo.new(
                0.22,
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.In
            ),
            {
                Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        0
                    )
            }
        )

    SettingsTween:Play()

    SettingsTween.Completed:Connect(
        function()

            if not SettingsOpen
                and SettingsPanel.Parent then

                SettingsPanel.Visible = false
            end
        end
    )
end

--==================================================
-- MAIN TOGGLE TEXT
--==================================================

local function UpdateMainToggle()

    if CurrentTab == "AIM" then

        MainToggle.Text =
            "AIM: " ..
            (
                AimEnabled
                and "ON"
                or "OFF"
            )

    else

        MainToggle.Text =
            "VISUALS: " ..
            (
                VisualsEnabled
                and "ON"
                or "OFF"
            )
    end
end

--==================================================
-- TAB
--==================================================

local function SwitchTab(tab)

    CurrentTab = tab

    AimPartDropdownOpen = false

    if tab == "AIM" then
        TabSelector.Text = "AIM ▼"
    else
        TabSelector.Text = "VISUALS ▼"
    end

    UpdateMainToggle()

    if SettingsOpen then

        RebuildSettings()

        if SettingsTween then
            SettingsTween:Cancel()
        end

        SettingsTween =
            TweenService:Create(
                SettingsPanel,
                TweenInfo.new(
                    0.22,
                    Enum.EasingStyle.Quint,
                    Enum.EasingDirection.Out
                ),
                {
                    Size =
                        UDim2.new(
                            1,
                            0,
                            0,
                            GetSettingsHeight()
                        )
                }
            )

        SettingsTween:Play()
    end
end

--==================================================
-- TAB DROPDOWN
--==================================================

local DropdownTween

local function ToggleDropdown()

    DropdownOpen =
        not DropdownOpen

    UpdateDropdownPosition()

    if DropdownTween then
        DropdownTween:Cancel()
    end

    if DropdownOpen then

        TabDrop.Visible = true

        TabDrop.Size =
            UDim2.fromOffset(
                205,
                0
            )

        DropdownTween =
            TweenService:Create(
                TabDrop,
                TweenInfo.new(
                    0.2,
                    Enum.EasingStyle.Quint,
                    Enum.EasingDirection.Out
                ),
                {
                    Size =
                        UDim2.fromOffset(
                            205,
                            76
                        )
                }
            )

        DropdownTween:Play()

    else

        DropdownTween =
            TweenService:Create(
                TabDrop,
                TweenInfo.new(
                    0.18,
                    Enum.EasingStyle.Quint,
                    Enum.EasingDirection.In
                ),
                {
                    Size =
                        UDim2.fromOffset(
                            205,
                            0
                        )
                }
            )

        DropdownTween:Play()

        DropdownTween.Completed:Connect(
            function()

                if not DropdownOpen then
                    TabDrop.Visible = false
                end
            end
        )
    end
end


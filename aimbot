local function CreateSlider(
    text,
    minValue,
    maxValue,
    currentValue,
    callback,
    y
)

    local holder = Instance.new("Frame")

    holder.Parent = SettingsPanel
    holder.Position =
        UDim2.fromOffset(15, y)

    holder.Size =
        UDim2.new(1, -30, 0, 58)

    holder.BackgroundTransparency = 1
    holder.ZIndex = 110

    local label = Instance.new("TextLabel")

    label.Parent = holder
    label.Size =
        UDim2.new(1, 0, 0, 22)

    label.BackgroundTransparency = 1
    label.TextColor3 =
        Color3.new(1, 1, 1)

    label.Font = Enum.Font.GothamMedium
    label.TextSize = 11
    label.TextXAlignment =
        Enum.TextXAlignment.Left

    label.ZIndex = 111

    local bar = Instance.new("Frame")

    bar.Parent = holder
    bar.Position =
        UDim2.fromOffset(0, 34)

    bar.Size =
        UDim2.new(1, 0, 0, 8)

    bar.BackgroundColor3 =
        Color3.fromRGB(55, 55, 55)

    bar.BorderSizePixel = 0
    bar.ZIndex = 111

    local barCorner = Instance.new("UICorner")

    barCorner.CornerRadius =
        UDim.new(1, 0)

    barCorner.Parent = bar

    local fill = Instance.new("Frame")

    fill.Parent = bar
    fill.BackgroundColor3 =
        Color3.fromRGB(145, 80, 255)

    fill.BorderSizePixel = 0
    fill.ZIndex = 112

    local fillCorner = Instance.new("UICorner")

    fillCorner.CornerRadius =
        UDim.new(1, 0)

    fillCorner.Parent = fill

    local knob = Instance.new("Frame")

    knob.Parent = bar
    knob.Size =
        UDim2.fromOffset(18, 18)

    knob.AnchorPoint =
        Vector2.new(0.5, 0.5)

    knob.BackgroundColor3 =
        Color3.new(1, 1, 1)

    knob.BorderSizePixel = 0
    knob.ZIndex = 113

    local knobCorner = Instance.new("UICorner")

    knobCorner.CornerRadius =
        UDim.new(1, 0)

    knobCorner.Parent = knob

    local function SetValue(value)

        value =
            math.clamp(
                value,
                minValue,
                maxValue
            )

        local alpha =
            (
                value - minValue
            ) /
            (
                maxValue - minValue
            )

        label.Text =
            text ..
            ": " ..
            tostring(
                math.floor(
                    value + 0.5
                )
            )

        fill.Size =
            UDim2.new(
                alpha,
                0,
                1,
                0
            )

        knob.Position =
            UDim2.new(
                alpha,
                0,
                0.5,
                0
            )

        callback(value)
    end

    local function UpdateFromInput(input)

        local width =
            bar.AbsoluteSize.X

        if width <= 0 then
            return
        end

        local alpha =
            math.clamp(
                (
                    input.Position.X
                    - bar.AbsolutePosition.X
                ) / width,
                0,
                1
            )

        SetValue(
            minValue +
            (
                maxValue - minValue
            ) * alpha
        )
    end

    Connect(
        bar.InputBegan,
        function(input)

            if input.UserInputType ==
                Enum.UserInputType.MouseButton1
                or input.UserInputType ==
                Enum.UserInputType.Touch then

                ActiveSlider = {
                    update = UpdateFromInput,
                    commit = SaveSettings
                }

                UpdateFromInput(input)
            end
        end
    )

    Connect(
        knob.InputBegan,
        function(input)

            if input.UserInputType ==
                Enum.UserInputType.MouseButton1
                or input.UserInputType ==
                Enum.UserInputType.Touch then

                ActiveSlider = {
                    update = UpdateFromInput,
                    commit = SaveSettings
                }
            end
        end
    )

    SetValue(currentValue)

    return holder
end


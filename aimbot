        local targetColor = state
            and Color3.fromRGB(55, 180, 95)
            or Color3.fromRGB(180, 55, 65)

        local targetPosition = state
            and UDim2.new(1, -19, 0.5, -8)
            or UDim2.new(0, 3, 0.5, -8)

        if animated == false then
            switch.BackgroundColor3 = targetColor
            knob.Position = targetPosition
        else
            TweenService:Create(
                switch,
                TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {BackgroundColor3 = targetColor}
            ):Play()

            TweenService:Create(
                knob,
                TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {Position = targetPosition}
            ):Play()
        end

        if invoke ~= false and callback then
            callback(state)
        end
    end

    Connect(switch.MouseButton1Click, function()
        control.set(not state, true, true)
    end)

    return control
end

local function CreateSubToggle(text, value, callback)
    local control = CreateToggle(
        text,
        value,
        callback,
        {
            Height = 32,
            X = 30,
            WidthOffset = 60,
            TextSize = 9,
            TextColor = Color3.fromRGB(185, 185, 185),
            Font = Enum.Font.Gotham
        }
    )

    control.holder.Size = UDim2.new(1, -60, 0, 0)
    control.holder.Visible = false

    function control.setVisible(visible, animated)
        visible = visible and true or false

        local targetSize = visible
            and UDim2.new(1, -60, 0, 32)
            or UDim2.new(1, -60, 0, 0)

        if visible then
            control.holder.Visible = true
        end

        if animated == false then
            control.holder.Size = targetSize
            control.holder.Visible = visible
        else
            local tween = TweenService:Create(
                control.holder,
                TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {Size = targetSize}
            )

            tween:Play()

            if not visible then
                task.spawn(function()
                    tween.Completed:Wait()

                    if control.holder.Parent then
                        control.holder.Visible = false
                    end
                end)
            end
        end
    end

    return control
end

local function CreateSlider(text, minimum, maximum, value, callback)
    local holder = Instance.new("Frame")
    holder.Name = "SliderHolder"
    holder.Size = UDim2.new(1, -12, 0, 58)
    holder.BackgroundTransparency = 1
    holder.Parent = SettingsScroll

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 4, 0, 0)
    label.Size = UDim2.new(0.7, 0, 0, 22)
    label.Font = Enum.Font.GothamMedium
    label.Text = text
    label.TextColor3 = Color3.fromRGB(235, 235, 235)
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local valueLabel = Instance.new("TextLabel")
    valueLabel.BackgroundTransparency = 1
    valueLabel.Position = UDim2.new(0.7, 0, 0, 0)
    valueLabel.Size = UDim2.new(0.3, -4, 0, 22)
    valueLabel.Font = Enum.Font.GothamMedium
    valueLabel.TextColor3 = Color3.fromRGB(175, 115, 255)
    valueLabel.TextSize = 10
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = holder

    local track = Instance.new("Frame")
    track.Name = "Track"
    track.Position = UDim2.new(0, 4, 0, 31)
    track.Size = UDim2.new(1, -8, 0, 6)
    track.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    track.BorderSizePixel = 0
    track.Parent = holder

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track

    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(155, 80, 255)
    fill.BorderSizePixel = 0
    fill.Parent = track

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = fill

    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.fromOffset(14, 14)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = track

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local currentValue = math.clamp(value, minimum, maximum)

    local function UpdateVisual()
        local alpha = (currentValue - minimum) / (maximum - minimum)

        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(math.floor(currentValue))
    end

    local function SetValue(newValue, invoke)
        currentValue = math.clamp(newValue, minimum, maximum)
        UpdateVisual()

        if invoke ~= false and callback then
            callback(currentValue)
        end
    end

    UpdateVisual()

    local function InputToValue(input)
        local absolute = track.AbsolutePosition
        local size = track.AbsoluteSize.X
        local alpha = math.clamp(
            (input.Position.X - absolute.X) / size,
            0,
            1
        )

        return minimum + (maximum - minimum) * alpha
    end

    Connect(track.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            ActiveSlider = {
                set = function()
                    SetValue(InputToValue(input))
                end,
                track = track
            }

            SetValue(InputToValue(input))
        end
    end)

    Connect(UserInputService.InputChanged, function(input)
        if not ActiveSlider then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local absolute = track.AbsolutePosition
            local size = track.AbsoluteSize.X
            local alpha = math.clamp(
                (input.Position.X - absolute.X) / size,
                0,
                1
            )

            SetValue(minimum + (maximum - minimum) * alpha)
        end
    end)

    Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            ActiveSlider = nil
        end
    end)

    return {
        holder = holder,
        set = SetValue,
        get = function()
            return currentValue
        end
    }
end


local function DestroyAlert(player)
    local object = AlertObjects[player]

    if not object then
        return
    end

    if object.frame then
        object.frame:Destroy()
    end

    AlertObjects[player] = nil
end

local function UpdateAlert(player, object)
    if not object then
        return
    end

    local character = player.Character
    local root = GetRoot(character)

    if not character or not root or not IsAlive(character) then
        object.frame.Visible = false
        return
    end

    if not Settings.Show360Alert or not VisualsEnabled then
        object.frame.Visible = false
        return
    end

    if player == LocalPlayer then
        object.frame.Visible = false
        return
    end

    if Settings.VisualsIgnoreTeam
        and LocalPlayer.Team ~= nil
        and player.Team == LocalPlayer.Team then
        object.frame.Visible = false
        return
    end

    local distance = (Camera.CFrame.Position - root.Position).Magnitude

    if distance > Settings.VisualsDistance then
        object.frame.Visible = false
        return
    end

    if IsHorizontallyOnScreen(root.Position) then
        object.frame.Visible = false
        return
    end

    local cameraPosition = Camera.CFrame.Position
    local direction = GetCameraHorizontalDirection(root.Position)
    local viewport = Camera.ViewportSize

    local screenCenter = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local cameraLook = Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z)

    if cameraLook.Magnitude < 0.001 then
        object.frame.Visible = false
        return
    end

    cameraLook = cameraLook.Unit

    local right = Vector3.new(cameraLook.Z, 0, -cameraLook.X)
    local forwardDot = direction:Dot(cameraLook)
    local rightDot = direction:Dot(right)

    local edgeX
    local edgeY

    if math.abs(rightDot) > math.abs(forwardDot) then
        edgeX = rightDot > 0 and viewport.X - 105 or 105
        edgeY = screenCenter.Y
    else
        edgeX = screenCenter.X
        edgeY = forwardDot > 0 and 100 or viewport.Y - 100
    end

    edgeX = math.clamp(edgeX, 100, viewport.X - 100)
    edgeY = math.clamp(edgeY, 60, viewport.Y - 60)

    object.frame.Position = UDim2.fromOffset(
        edgeX - 95,
        edgeY - 38
    )

    object.frame.Visible = true

    object.character.Visible = Settings.AlertCharacter

    if Settings.AlertName then
        object.name.Visible = true
        object.name.Text = player.DisplayName
    else
        object.name.Visible = false
    end

    if Settings.AlertUsername then
        object.username.Visible = true
        object.username.Text = "@" .. player.Name
    else
        object.username.Visible = false
    end

    if Settings.AlertTeam then

local RECORDING_FILE = TAS_PATH .. "recording_"

-- ============================================================
-- ===== ИНИЦИАЛИЗАЦИЯ =====
-- ============================================================
if not isfolder(TAS_PATH) then
    makefolder(TAS_PATH)
end

-- ============================================================
-- ===== TAS =====
-- ============================================================
local isRecording = false
local isPlaying = false
local recordingData = {}
local playbackConnection = nil
local recordConnection = nil
local selectedSlot = 1
local frameCount = 0

local function GetRoot()
    local char = LocalPlayer.Character
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function UpdateStatus(text, color)
    if statusText then
        statusText.Text = text
        statusText.TextColor3 = color
        print("[TAS] " .. text)
    end
end

-- ===== КНОПКА 1: ЗАПИСЬ =====
local function StartRecording()
    if isRecording then 
        UpdateStatus("⏳ УЖЕ ЗАПИСЬ", Color3.fromRGB(255, 255, 0))
        return 
    end
    
    local root = GetRoot()
    if not root then 
        UpdateStatus("❌ НЕТ ПЕРСОНАЖА", Color3.fromRGB(255, 0, 0))
        return 
    end
    
    isRecording = true
    recordingData = {}
    frameCount = 0
    local startTime = tick()
    
    UpdateStatus("🔴 ЗАПИСЬ... (0 кадров)", Color3.fromRGB(255, 0, 0))
    
    recordConnection = RunService.Heartbeat:Connect(function()
        if not isRecording then 
            recordConnection:Disconnect()
            recordConnection = nil
            return 
        end
        
        local root = GetRoot()
        if not root then return end
        
        local pos = root.Position
        local angle = root.Orientation.Y
        local currentTime = tick() - startTime
        
        table.insert(recordingData, {
            time = currentTime,
            x = pos.X,
            y = pos.Y,
            z = pos.Z,
            angle = angle
        })
        
        frameCount = frameCount + 1
        if frameCount % 10 == 0 then
            UpdateStatus("🔴 ЗАПИСЬ... (" .. frameCount .. " кадров)", Color3.fromRGB(255, 0, 0))
        end
    end)
end

-- ===== КНОПКА 2: СТОП ЗАПИСЬ =====
local function StopRecording()
    if not isRecording then 
        UpdateStatus("⚠️ ЗАПИСЬ НЕ АКТИВНА", Color3.fromRGB(255, 255, 0))
        return 
    end
    
    isRecording = false
    
    if recordConnection then
        recordConnection:Disconnect()
        recordConnection = nil
    end
    
    if #recordingData == 0 then 
        UpdateStatus("❌ НЕТ ДАННЫХ", Color3.fromRGB(255, 0, 0))
        return 
    end
    
    local filePath = RECORDING_FILE .. selectedSlot .. ".txt"
    local content = ""
    for _, data in ipairs(recordingData) do
        content = content .. string.format("%.3f %.3f %.3f %.3f %.3f\n", 
            data.time, data.x, data.y, data.z, data.angle)
    end
    writefile(filePath, content)
    recordingData = {}
    
    UpdateStatus("✅ СОХРАНЕНО (" .. frameCount .. " кадров, слот " .. selectedSlot .. ")", Color3.fromRGB(0, 255, 0))
    frameCount = 0
end

-- ===== КНОПКА 3: ВОСПРОИЗВЕСТИ =====
local function PlayRecording()
    if isPlaying then 
        UpdateStatus("⏳ УЖЕ ВОСПР.", Color3.fromRGB(255, 255, 0))
        return 
    end
    
    local filePath = RECORDING_FILE .. selectedSlot .. ".txt"
    if not isfile(filePath) then 
        UpdateStatus("❌ СЛОТ " .. selectedSlot .. " ПУСТ", Color3.fromRGB(255, 0, 0))
        return 
    end
    
    local content = readfile(filePath)
    local frames = {}
    for line in content:gmatch("[^\n]+") do
        local time, x, y, z, angle = line:match("([%d.]+)%s+([%d.]+)%s+([%d.]+)%s+([%d.]+)%s+([%d.]+)")
        if time and x and y and z and angle then
            table.insert(frames, {
                time = tonumber(time),
                x = tonumber(x),
                y = tonumber(y),
                z = tonumber(z),
                angle = tonumber(angle)
            })
        end
    end
    
    if #frames == 0 then 
        UpdateStatus("❌ ФАЙЛ ПОВРЕЖДЁН", Color3.fromRGB(255, 0, 0))
        return 
    end
    
    isPlaying = true
    local startTime = tick()
    local currentFrame = 1
    
    UpdateStatus("▶️ ВОСПР. (" .. #frames .. " кадров)", Color3.fromRGB(0, 255, 255))
    
    playbackConnection = RunService.Heartbeat:Connect(function()
        if not isPlaying then
            playbackConnection:Disconnect()
            playbackConnection = nil
            return
        end
        
        local elapsed = tick() - startTime
        
        while currentFrame <= #frames and frames[currentFrame].time <= elapsed do
            local frame = frames[currentFrame]
            local root = GetRoot()
            if root then
                root.CFrame = CFrame.new(frame.x, frame.y, frame.z) * CFrame.Angles(0, math.rad(frame.angle), 0)
            end
            currentFrame = currentFrame + 1
        end
        
        if currentFrame > #frames then
            isPlaying = false
            if playbackConnection then
                playbackConnection:Disconnect()
                playbackConnection = nil
            end
            UpdateStatus("✅ ВОСПР. ЗАВЕРШЕНО (" .. #frames .. " кадров)", Color3.fromRGB(0, 255, 0))
        end
    end)
end

-- ===== КНОПКА 4: СТОП ВОСПР. =====
local function StopPlayback()
    if isPlaying then
        isPlaying = false
        if playbackConnection then
            playbackConnection:Disconnect()
            playbackConnection = nil
        end
        UpdateStatus("⏹ ОСТАНОВЛЕНО", Color3.fromRGB(255, 255, 0))
    else
        UpdateStatus("⚠️ НЕТ ВОСПР.", Color3.fromRGB(255, 255, 0))
    end
end

-- ===== КНОПКА 5: УДАЛИТЬ =====
local function DeleteRecording()
    local filePath = RECORDING_FILE .. selectedSlot .. ".txt"
    if isfile(filePath) then
        delfile(filePath)
        UpdateStatus("🗑 УДАЛЕНО (слот " .. selectedSlot .. ")", Color3.fromRGB(255, 100, 0))
    else
        UpdateStatus("❌ СЛОТ " .. selectedSlot .. " ПУСТ", Color3.fromRGB(255, 0, 0))
    end
end


-- ============================================================
-- ===== ФУНКЦИЯ ПРОВЕРКИ ВИДИМОСТИ =====
-- ============================================================
local function isPartVisible(part)
    if not part then return false end
    local origin = camera.CFrame.Position
    local targetPos = part.Position
    if part:IsDescendantOf(player.Character) then return false end
    local direction = (targetPos - origin).unit
    local distance = (targetPos - origin).magnitude
    local ray = Ray.new(origin, direction * distance)
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {player.Character, part.Parent})
    if not hit then return true end
    if hit:IsDescendantOf(part.Parent) then return true end
    return false
end

-- ============================================================
-- ===== ФУНКЦИИ АИМБОТА =====
-- ============================================================
local function getTargetClosestToCenter()
    local viewport = camera.ViewportSize
    local cx, cy = viewport.X / 2, viewport.Y / 2
    local origin = camera.CFrame.Position
    local best, bestDist = nil, math.huge
    local myHead = player.Character and player.Character:FindFirstChild("Head")
    local myTeam = player.Team

    for _, v in ipairs(game:GetService("Players"):GetPlayers()) do
        if v == player or not v.Character then continue end
        if settings.ignoreTeam and myTeam and v.Team == myTeam then continue end

        local hum = v.Character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then continue end

        local part = v.Character:FindFirstChild(settings.aimPart)
        if not part then
            part = v.Character:FindFirstChild("Head") or v.Character:FindFirstChild("HumanoidRootPart")
        end
        if not part then continue end
        if myHead and part == myHead then continue end
        if part:IsDescendantOf(player.Character) then continue end

        local pos, onScreen = camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local dist = (part.Position - origin).magnitude
        if dist > settings.maxDistance then continue end

        if settings.visibleCheck then
            if not isPartVisible(part) then
                continue
            end
        end

        local dx, dy = pos.X - cx, pos.Y - cy
        local dCenter = math.sqrt(dx * dx + dy * dy)
        if dCenter < settings.fov and dCenter < bestDist then
            bestDist = dCenter
            best = v
        end
    end
    return best
end

local function lockTarget(target)
    if not target or not target.Character then return end
    
    local part = target.Character:FindFirstChild(settings.aimPart)
    if not part then
        part = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
    end
    if not part then return end
    
    if settings.visibleCheck then
        if not isPartVisible(part) then
            lockedTarget = nil
            findTarget()
            return
        end
    end
    
    local camPos = camera.CFrame.Position
    local targetCF = CFrame.lookAt(camPos, part.Position)
    camera.CFrame = camera.CFrame:Lerp(targetCF, settings.resistance)
end

local function findTarget()
    if not aimbotEnabled then return end
    local t = getTargetClosestToCenter()
    lockedTarget = t or nil
end


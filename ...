local function RemoveESPObjects(name)
    local obj = espObjects[name]
    if not obj then return end
    if obj.gui then obj.gui:Destroy() end
    if obj.highlight then obj.highlight:Destroy() end
    if obj.lookArrow then obj.lookArrow:Destroy() end
    if obj.lookArrowTip then obj.lookArrowTip:Destroy() end
    if obj.tracer then obj.tracer:Destroy() end
    espObjects[name] = nil
end

local function ClearESP()
    for name, _ in pairs(espObjects) do
        RemoveESPObjects(name)
    end
    espObjects = {}
end

-- ============================================================
-- ===== ИДЕАЛЬНЫЕ TRACERS (ОБНОВЛЁННЫЕ) =====
-- ============================================================
local function UpdateTracers()
    local cfg = _G.ESP
    if not cfg.Enabled or not cfg.ShowTracers then
        for _, obj in pairs(espObjects) do
            if obj and obj.tracer then
                obj.tracer.Visible = false
            end
        end
        return
    end
    
    local viewportSize = camera.ViewportSize
    local centerX = viewportSize.X / 2
    local centerY = viewportSize.Y / 2 - 30 -- сдвиг, как у круга
    
    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr == player then continue
        local obj = espObjects[plr.Name]
        if not obj or not obj.tracer then continue
        
        local head = plr.Character and plr.Character:FindFirstChild("Head")
        if not head then
            obj.tracer.Visible = false
            continue
        end
        
        -- Проецируем голову на экран
        local screenPos, onScreen = WorldToViewport(head.Position)
        if not screenPos then
            obj.tracer.Visible = false
            continue
        end
        
        local targetX = screenPos.X
        local targetY = screenPos.Y
        
        -- Если цель за пределами экрана — рисуем линию к краю
        if not onScreen then
            -- Находим точку пересечения линии с границей экрана
            local dx = targetX - centerX
            local dy = targetY - centerY
            if dx == 0 and dy == 0 then
                obj.tracer.Visible = false
                continue
            end
            
            local maxDist = math.sqrt(viewportSize.X^2 + viewportSize.Y^2)
            local scale = maxDist / math.sqrt(dx^2 + dy^2)
            targetX = centerX + dx * scale
            targetY = centerY + dy * scale
            
            -- Обрезаем до границ экрана
            targetX = math.clamp(targetX, 0, viewportSize.X)
            targetY = math.clamp(targetY, 0, viewportSize.Y)
        end
        
        -- Вычисляем длину и угол линии
        local dx = targetX - centerX
        local dy = targetY - centerY
        local length = math.sqrt(dx^2 + dy^2)
        
        if length < 1 then
            obj.tracer.Visible = false
            continue
        end
        
        local angle = math.atan2(dy, dx)
        
        -- Применяем к трассеру
        obj.tracer.Visible = true
        obj.tracer.Size = UDim2.new(0, length, 0, 2)
        obj.tracer.Position = UDim2.new(0, centerX, 0, centerY)
        obj.tracer.Rotation = math.deg(angle)
        obj.tracer.BackgroundColor3 = GetTeamColor(plr)
        obj.tracer.BackgroundTransparency = 0.3
    end
end


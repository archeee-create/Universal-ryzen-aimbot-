-- ===== СОХРАНЕНИЕ =====
local saveFolder = "RyzenAimbot"
local saveFile = "settings.json"
local fullPath = saveFolder .. "/" .. saveFile

local function ensureFolder()
    if not isfolder then return false end
    if not isfolder(saveFolder) then
        pcall(function() makefolder(saveFolder) end)
    end
    return isfolder(saveFolder)
end

local function loadSettings()
    local default = {
        fov = 20,
        maxDistance = 50,
        aimPart = "Head",
        visibleCheck = true,
        ignoreTeam = false,
        resistance = 0.85,
        espEnabled = false,
        showDistance = false,
        showName = false,
        showTeam = false,
        showLookDirection = false,
        showHighlight = false,
        showTracers = false
    }
    if not ensureFolder() then return default end
    if not isfile(fullPath) then return default end
    local success, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(fullPath))
    end)
    if success and type(data) == "table" then
        for k, v in pairs(default) do
            if data[k] == nil then data[k] = v end
        end
        return data
    end
    return default
end

local function saveSettings(data)
    if not ensureFolder() then return end
    pcall(function()
        writefile(fullPath, game:GetService("HttpService"):JSONEncode(data))
    end)
end


-- ===== ОБНОВЛЕНИЕ ESP =====
-- ============================================================
local function UpdateESP()
    local cfg = _G.ESP
    if not cfg.Enabled then
        ClearESP()
        return
    end
    
    local myChar = player.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr == player then continue end
        
        local char = plr.Character
        if not char or not char.Parent then
            if espObjects[plr.Name] then RemoveESPObjects(plr.Name) end
            continue
        end
        
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            if espObjects[plr.Name] then RemoveESPObjects(plr.Name) end
            continue
        end
        
        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not head or not root then continue end
        
        if not espObjects[plr.Name] then CreateESPObjects(plr) end
        local obj = espObjects[plr.Name]
        
        local headPos, headOnScreen = WorldToViewport(head.Position)
        local rootPos, rootOnScreen = WorldToViewport(root.Position)
        
        if not headOnScreen or not rootOnScreen then
            if obj.nameLabel then obj.nameLabel.Visible = false end
            if obj.distanceLabel then obj.distanceLabel.Visible = false end
            if obj.teamLabel then obj.teamLabel.Visible = false end
            if obj.highlight then obj.highlight.Enabled = false end
            if obj.lookArrow then obj.lookArrow.Visible = false end
            if obj.lookArrowTip then obj.lookArrowTip.Visible = false end
            continue
        end
        
        local teamColor = GetTeamColor(plr)
        local teamName = GetTeamName(plr)
        
        if cfg.ShowHighlight and obj.highlight then
            obj.highlight.Enabled = true
            obj.highlight.FillColor = teamColor
            obj.highlight.FillTransparency = 0.4
            obj.highlight.OutlineColor = teamColor
            obj.highlight.OutlineTransparency = 0.1
        else
            if obj.highlight then obj.highlight.Enabled = false end
        end
        
        if cfg.ShowName and obj.nameLabel then
            obj.nameLabel.Visible = true
            obj.nameLabel.Text = plr.Name
            obj.nameLabel.Position = UDim2.new(0, headPos.X - 100, 0, headPos.Y - 50)
            obj.nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            if obj.nameLabel then obj.nameLabel.Visible = false end
        end
        
        if cfg.ShowDistance and obj.distanceLabel then
            local dist = (myRoot.Position - root.Position).Magnitude
            obj.distanceLabel.Visible = true
            obj.distanceLabel.Text = string.format("%.0f studs", dist)
            obj.distanceLabel.Position = UDim2.new(0, headPos.X - 50, 0, headPos.Y - 30)
            obj.distanceLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        else
            if obj.distanceLabel then obj.distanceLabel.Visible = false end
        end
        
        if cfg.ShowTeam and obj.teamLabel and teamName ~= "" then
            obj.teamLabel.Visible = true
            obj.teamLabel.Text = teamName
            obj.teamLabel.Position = UDim2.new(0, headPos.X - 50, 0, headPos.Y + 15)
            obj.teamLabel.TextColor3 = teamColor
        else
            if obj.teamLabel then obj.teamLabel.Visible = false end
        end
        
        if cfg.ShowLookDirection then
            if not obj.arrowCreated then
                local arrow = Instance.new("Frame")
                arrow.Size = UDim2.new(0, 2, 0, 30)
                arrow.BackgroundColor3 = teamColor
                arrow.BackgroundTransparency = 0.3
                arrow.BorderSizePixel = 0
                arrow.Visible = false
                arrow.Parent = obj.gui
                obj.lookArrow = arrow
                
                local tip = Instance.new("Frame")
                tip.Size = UDim2.new(0, 8, 0, 8)
                tip.BackgroundColor3 = teamColor
                tip.BackgroundTransparency = 0.3
                tip.BorderSizePixel = 0
                tip.Visible = false
                tip.Parent = obj.gui
                obj.lookArrowTip = tip
                obj.arrowCreated = true
            end
            
            if obj.lookArrow and obj.lookArrowTip then
                local lookVector = root.CFrame.LookVector
                local endPos = root.Position + (lookVector * 5)
                local endPos2D, endOnScreen = WorldToViewport(endPos)
                
                if endOnScreen then
                    local dx = endPos2D.X - rootPos.X
                    local dy = endPos2D.Y - rootPos.Y
                    local angle = math.atan2(dy, dx)
                    local length = math.sqrt(dx*dx + dy*dy)
                    
                    obj.lookArrow.Visible = true
                    obj.lookArrow.Size = UDim2.new(0, length, 0, 2)
                    obj.lookArrow.Position = UDim2.new(0, rootPos.X, 0, rootPos.Y - 1)
                    obj.lookArrow.Rotation = math.deg(angle)
                    obj.lookArrow.BackgroundColor3 = teamColor
                    
                    obj.lookArrowTip.Visible = true
                    obj.lookArrowTip.Position = UDim2.new(0, endPos2D.X - 4, 0, endPos2D.Y - 4)
                    obj.lookArrowTip.BackgroundColor3 = teamColor
                    obj.lookArrowTip.Rotation = math.deg(angle)
                else
                    if obj.lookArrow then obj.lookArrow.Visible = false end
                    if obj.lookArrowTip then obj.lookArrowTip.Visible = false end
                end
            end
        else
            if obj.lookArrow then
                obj.lookArrow.Visible = false
                obj.lookArrow:Destroy()
                obj.lookArrow = nil
            end
            if obj.lookArrowTip then
                obj.lookArrowTip.Visible = false
                obj.lookArrowTip:Destroy()
                obj.lookArrowTip = nil
            end
            obj.arrowCreated = false
        end
    end
end


    local part = lockedTarget.Character:FindFirstChild(settings.aimPart)
    if not part then
        part = lockedTarget.Character:FindFirstChild("Head") or lockedTarget.Character:FindFirstChild("HumanoidRootPart")
    end
    if not part then
        findTarget()
        return
    end
    
    lockTarget(lockedTarget)
end)

game:GetService("RunService").Heartbeat:Connect(function()
    if aimbotEnabled and not lockedTarget then findTarget() end
end)

player.CharacterAdded:Connect(function()
    wait(1)
    aimbotEnabled = false
    lockedTarget = nil
    DestroyFOVCircle()
end)

Rayfield:Notify({
    Title = "Ryzen System",
    Content = "Аимбот + Visuals (Идеальные Tracers) загружены",
    Duration = 3
})
